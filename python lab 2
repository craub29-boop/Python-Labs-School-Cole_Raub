    guess = "test1"
    num = int(rng_number())
    guess_amount = 0


def check_guess(guess, num):
    global guess_amount

    distance = abs(guess - num)
    if distance == 0:
        print("correct")
        print("It took you " + str(guess_amount) + " tries.")
        guess_amount = 0
        return True
