import random as rng

def take_input():
    guess = input("left or right?")
    if guess == "left":
        guess_num = 1
    elif guess == "right":
        guess_num = 2
    return guess_num

def start_game():
    print("Welcome to the game!")
    print("I will ask you to choose left or right.")
    return 

def main():
    start_game()
    while True:
        number = rng.randint(1, 2)
        guess_num = take_input()
        if guess_num == number:
            print("You guessed correctly!")
        else:
            print("Wrong! The correct answer was", "left" if number == 1 else "right")

