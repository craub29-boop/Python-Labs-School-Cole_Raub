import random as rng


def take_input():
    while True:
        guess = input("left or right? ").strip().lower()
        if guess == "left":
            return 1
        if guess == "right":
            return 2
        print("Please type 'left' or 'right'.")


def start_game():
    print("Welcome to the game!")
    print("I will ask you to choose left or right.")


def main():
    start_game()
    while True:
        number = rng.randint(1, 2)
        guess_num = take_input()

        if guess_num == number:
            print("Correct")
        else:
            print("Wrong! Answer:", "left" if number == 1 else "right")

        play_again = input("Play again? (y/n): ").strip().lower()
        if play_again != "y":
            print("bye")
            break


if __name__ == "__main__":
    main()

