from collections import Counter
from pathlib import Path

WORD_LENGTH = 5
VALID_COLORS = {"g", "y", "gr"}


def explain():
    print("Wordle rules:")
    print("- g = green (correct letter in correct place)")
    print("- y = yellow (letter is in the word, but not in that spot)")
    print("- gr = gray (letter is not in the word)")
    print("Enter the guess as a 5-letter word, then enter the colors as 5 values.")
    print("Example: g y gr g g")


def find_word_list():
    search_roots = [
        Path(__file__).resolve().parent,
        Path.cwd(),
    ]

    candidate_names = ["word_list.txt", "words.txt", "wordle_words.txt", "valid-wordle-words.txt"]

    for root in search_roots:
        for name in candidate_names:
            candidate = root / name
            if candidate.exists():
                return candidate

        for path in root.rglob("*"):
            if path.is_file() and path.name.lower() in {name.lower() for name in candidate_names}:
                return path

    return Path(__file__).resolve().parent / "word_list.txt"


def load_word_list(file_path=None):
    file_path = Path(file_path) if file_path else find_word_list()

    if not file_path.exists():
        raise FileNotFoundError(f"Word list not found: {file_path}")

    words = []
    with file_path.open("r", encoding="utf-8") as handle:
        for line in handle:
            word = line.strip().lower()
            if len(word) == WORD_LENGTH and word.isalpha():
                words.append(word)

    if not words:
        raise ValueError(f"No valid 5-letter words found in {file_path}")

    return words


def word_input(prompt="guess: "):
    while True:
        user_input = input(prompt).strip().lower()
        if len(user_input) != WORD_LENGTH or not user_input.isalpha():
            print("Enter a valid 5-letter word.")
            continue
        return user_input


def parse_clue(raw_clue):
    cleaned = raw_clue.strip().lower().replace(",", " ").replace("|", " ")
    tokens = cleaned.split()

    if not tokens:
        raise ValueError("No color values entered.")

    if len(tokens) == 1 and tokens[0] == "gr":
        return ["gr"] * WORD_LENGTH

    if len(tokens) == WORD_LENGTH and all(token in VALID_COLORS for token in tokens):
        return tokens

    if len(cleaned) == WORD_LENGTH and all(char in {"g", "y"} for char in cleaned):
        return list(cleaned)

    raise ValueError("Use 5 color values like: g y gr g g")


def take_color():
    while True:
        try:
            raw = input("color: ").strip()
            clue = parse_clue(raw)
            if len(clue) == WORD_LENGTH:
                return clue
        except ValueError:
            print("Enter valid colors: g, y, or gr. Example: g y gr g g")


def evaluate_guess(secret, guess):
    if len(secret) != WORD_LENGTH or len(guess) != WORD_LENGTH:
        raise ValueError("Both words must be 5 letters long.")

    result = ["gr"] * WORD_LENGTH
    remaining_letters = Counter()

    for index, (secret_letter, guess_letter) in enumerate(zip(secret, guess)):
        if secret_letter == guess_letter:
            result[index] = "g"
        else:
            remaining_letters[secret_letter] += 1

    for index, guess_letter in enumerate(guess):
        if result[index] == "g":
            continue
        if remaining_letters.get(guess_letter, 0) > 0:
            result[index] = "y"
            remaining_letters[guess_letter] -= 1

    return result


def matches_clue(candidate, guess, clue):
    return evaluate_guess(candidate, guess) == clue


def filter_words(words, guess, clue):
    filtered = [word for word in words if matches_clue(word, guess, clue)]
    return filtered


def suggest_word(words, full_words=None):
    if not words:
        return None

    if full_words is None:
        full_words = words
    full_words = [word.lower() for word in full_words if len(word) == WORD_LENGTH and word.isalpha()]

    if 3 <= len(words) <= 5:
        varying_positions = []
        for index in range(WORD_LENGTH):
            if len({word[index] for word in words}) > 1:
                varying_positions.append(index)

        if len(varying_positions) == 1:
            index = varying_positions[0]
            varying_letters = {word[index] for word in words}
            fixed_letters = set()

            for fixed_index in range(WORD_LENGTH):
                if fixed_index == index:
                    continue
                letter_set = {word[fixed_index] for word in words}
                if len(letter_set) == 1:
                    fixed_letters.update(letter_set)

            if len(varying_letters) >= 2:
                def cluster_score(candidate):
                    candidate_set = set(candidate)
                    differing_match = len(candidate_set & varying_letters)
                    shared_match = len(candidate_set & fixed_letters)
                    total_match = len(candidate_set & (varying_letters | fixed_letters))
                    return (differing_match, shared_match, total_match, candidate)

                best_word = sorted(full_words, key=lambda word: (-cluster_score(word)[0], -cluster_score(word)[1], -cluster_score(word)[2], word))[0]
                if best_word:
                    return best_word

    letter_scores = Counter()
    for word in words:
        for letter in set(word):
            letter_scores[letter] += 1

    all_letters = set("".join(words))

    if len(words) >= 3:
        max_hamming = 0
        for i, left in enumerate(words):
            for right in words[i + 1:]:
                diff = sum(a != b for a, b in zip(left, right))
                max_hamming = max(max_hamming, diff)

        if max_hamming <= 2:
            def cluster_score(word):
                covered_letters = sum(1 for letter in all_letters if letter in set(word))
                frequency_score = sum(letter_scores[letter] for letter in set(word))
                return (covered_letters, frequency_score, word)

            candidates = full_words if full_words else words
            return max(candidates, key=cluster_score)

    def score(word):
        covered_letters = sum(1 for letter in all_letters if letter in set(word))
        frequency_score = sum(letter_scores[letter] for letter in set(word))
        return (covered_letters, frequency_score, -len(set(word)), word)

    best_word = max(full_words, key=score)
    return best_word


def main():
    explain()

    try:
        all_words = load_word_list()
        words = all_words[:]
    except FileNotFoundError as exc:
        print(f"{exc}\nCreate a word_list.txt file in the same folder with 5-letter words, one per line.")
        return
    except ValueError as exc:
        print(f"{exc}")
        return

    print(f"Loaded {len(words)} possible words from the text file.")

    while True:
        try:
            guess = word_input("guess: ")
            clue = take_color()
            words = filter_words(words, guess, clue)

            if not words:
                print("No words match those rules. Check the clue and try again.")
                continue

            print(f"Words left: {len(words)}")
            print("Possible words:", words[:10])

            if len(words) == 1:
                print(f"The answer is: {words[0]}")
                break

            print("Best next guess:", suggest_word(words, full_words=all_words))

            try:
                again = input("Do you want to enter another guess? (y/n): ").strip().lower()
            except EOFError:
                print("\nInput closed. Exiting Wordle solver.")
                return

            if again in {"n", "no"}:
                break
        except KeyboardInterrupt:
            print("\nProgram closed.")
            break
        except EOFError:
            print("\nInput closed. Exiting Wordle solver.")
            return


if __name__ == "__main__":
    main()
