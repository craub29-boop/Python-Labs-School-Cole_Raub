
def start():
    print("Welcome to Cole's Calc")
    print("press q to quit")

def check_if_number(num):
    try:
        float(num)
        return True
    except ValueError:
        return False

def take_num_1():
    while True:
        num_1 = input("Enter first number: ")
        if num_1 == "q":
            print("goodbye calc")
            quit()
        elif check_if_number(num_1):
            return float(num_1)
        else:
            print("Enter a valid number or 'q' to quit.")

def take_num_2():
    while True:
        num_2 = input("Enter second number: ")
        if num_2 == "q":
            print("goodbye calc")
            quit()
        elif check_if_number(num_2):
            return float(num_2)
        else:
            print("Enter a valid number or 'q' to quit.")

def take_operator():
    while True:
        operator = input("Enter operator: ").strip().lower()
        if operator == "q":
            print("goodbye calc")
            quit()
        elif operator in ["a", "s", "m", "d"]:
            return operator
        else:
            print("Enter a valid operator or 'q' to quit.")

def take_input():
    num_1 = take_num_1()
    operator = take_operator()
    num_2 = take_num_2()
    return num_1, operator, num_2

def explain():
    print("(a)ddition, (s)ubtraction, (m)ultiplication, (d)ivision")

def calculate(num_1, operator, num_2):
    if operator == "a":
        return num_1 + num_2
    elif operator == "s":
        return num_1 - num_2
    elif operator == "m":
        return num_1 * num_2
    elif operator == "d":
        if num_2 != 0:
            return num_1 / num_2
        else:
            print("Error: Division by zero is not allowed.")
            print("You have lost calc privileges and have beaten the game")
            quit()
            return None

def main():
    start()
    while True:
        explain()
        num_1, operator, num_2 = take_input()
        result = calculate(num_1, operator, num_2)
        if result is not None:
            print(f"Result: {result}")

num_1, operator, num_2 = "test", "test", "test"

main()