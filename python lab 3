#setup da stuff
def start():
    global prev_ans
    prev_ans = 0.0
    print("Welcome to Cole's Calc")
    print("(calc is short for calculator if you didn't know)")
    print("press q to quit")
    print("press ans to use the previous answer")

#checks if number via rounding(you cant round strings)
def check_if_number(num):
    try:
        float(num)
        return True
    except ValueError:
        return False

#takes and filters the first number input
def take_num_1():
    while True:
        num_1 = input("Enter first number: ").strip()
        if num_1.lower() == "q":
            print("goodbye calc")
            quit()
        elif num_1.lower() == "ans":
            return prev_ans
        elif check_if_number(num_1):
            return float(num_1)
        else:
            print("Enter a valid number or 'q' to quit.")

#takes and filters the second number input
def take_num_2():
    while True:
        num_2 = input("Enter second number: ").strip()
        if num_2.lower() == "q":
            print("goodbye calc")
            quit()
        elif num_2.lower() == "ans":
            return prev_ans
        elif check_if_number(num_2):
            return float(num_2)
        else:
            print("Enter a valid number or 'q' to quit.")

#takes and filters the operator input
def take_operator():
    while True:
        operator = input("Enter operator: ").strip().lower()
        if operator == "q":
            print("goodbye calc")
            quit()
        elif operator in ["a", "s", "m", "d"]:
            return operator
        else:
            print("Enter a valid operator or 'q' to quit.")

#combines all inputs into one function to call
def take_input():
    num_1 = take_num_1()
    operator = take_operator()
    num_2 = take_num_2()
    return num_1, operator, num_2

#explains how it works 
def explain():
    print("(a)ddition, (s)ubtraction, (m)ultiplication, (d)ivision")

#evaluates the math 
def calculate(num_1, operator, num_2):
    global prev_ans
    if operator == "a":
        return num_1 + num_2
    elif operator == "s":
        return num_1 - num_2
    elif operator == "m":
        return num_1 * num_2
    elif operator == "d":
        if num_2 != 0:
            return num_1 / num_2
        else:
            print("Error: Division by zero is not allowed.")
            print("You have lost calc privileges and have beaten the game")
            quit()
            return None

#holds the actual structure 
def main():
    global prev_ans
    start()
    while True:
        explain()
        num_1, operator, num_2 = take_input()
        result = calculate(num_1, operator, num_2)
        if result is not None:
            prev_ans = result
            if result == 67:
                print("6767676767676767676776767676776767676776767676776")
            print(f"Result: {result}")

#runs code 
if __name__ == "__main__":
    main()